GEMINI_API_KEY=
FAL_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional per-creator destinations: a JSON object mapping creator IDs to chat IDs.
# Example: {"creator-01":"123456789","creator-02":"-1001234567890"}
TELEGRAM_CREATOR_CHAT_IDS=

# Optional provider overrides
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image
FAL_KLING_MODEL=fal-ai/kling-video/v3/standard/image-to-video

# Runtime defaults
DATA_DIR=/data
RUN_TIME=08:00
TIMEZONE=America/Los_Angeles
LOG_LEVEL=INFO
FAL_POLL_SECONDS=60
FAL_INITIAL_POLL_DELAY_SECONDS=180
