# Configure the same random token in Portal > Settings > Reverse Connection.
PHONE_DEVICE_TOKEN=
# Optional at first connection. Pin the reported ID for subsequent runs.
PHONE_DEVICE_ID=
# Enable Portal's persistent wake watchdog on connection for this dev phone.
# It remains enabled until switched off in Portal Settings > Keep Screen Awake.
PHONE_KEEP_SCREEN_AWAKE=0
# Portal waits an extra 100 ms to hide its overlay before each screenshot.
# Set to 0 only if Portal's overlay is disabled and test captures stay clear.
PHONE_SCREENSHOT_HIDE_OVERLAY=1
# Return Home and lock the display after successful executed tasks. The wake
# watchdog is disabled during cleanup and enabled again before the next task.
PHONE_PARK_ON_FINISH=1
# Vision inference is separate from Nano Banana image generation.
PHONE_GEMINI_API_KEY=
# Set an available Gemini model with image input and structured output support.
PHONE_VISION_MODEL=
# Optional cheaper model for timed browsing; the main model handles publishing,
# research, and one fallback before any uncertain browsing input is dispatched.
# PHONE_BROWSE_MODEL=gemini-3.1-flash-lite
# Optional faster model for general navigation, with main-model fallback for
# low-confidence or consequential decisions. Publishing keeps PHONE_VISION_MODEL.
# PHONE_NAV_MODEL=gemini-3.1-flash-lite
# Experimental: use Portal's visible accessibility tree for low-risk text-only
# navigation choices, falling back to the existing screenshot model. The
# controller still captures screenshots for evidence and freshness checks.
# PHONE_SEMANTIC_NAV=0
# Optional text-only model for that path; defaults to PHONE_BROWSE_MODEL,
# then PHONE_NAV_MODEL, then PHONE_VISION_MODEL. Use a tested model.
# PHONE_SEMANTIC_MODEL=gemini-3.1-flash-lite
# Optional private local task-control socket; default is phone-agent/.control.sock.
# Use the same path for the serve and submit/status/cancel/capture clients.
# PHONE_CONTROL_SOCKET=
